{
  "name": "stock-import-for-shop",
  "version": "0.1.1",
  "tablePrefix": "stk_",
  "description": "Keeps shop stock counts in step with a supplier's stock file: point it at a CSV url, pick how often to check, and every product whose SKU appears in the file gets its stock count refreshed. Includes a Fetch Latest Stock button on the Products page for when you cannot wait for the schedule.",
  "requiresCoreVersion": "0.5.965",
  "requiresModules": [
    { "name": "shop", "minVersion": "0.1.61" }
  ],
  "permissions": [],
  "navEntries": [],
  "settingsTabs": [
    {
      "id": "stock-import-for-shop",
      "label": "Stock",
      "permission": "shop.manage",
      "host": "shop.settings-sub-tabs",
      "import": "./components/SettingsTab",
      "component": "StockImportSettingsTab"
    }
  ],
  "extensionPoints": [
    {
      "point": "shop.products-toolbar",
      "id": "stock-import-products-toolbar",
      "permission": "shop.products",
      "import": "./components/ProductsToolbar",
      "component": "StockImportProductsToolbar"
    }
  ],
  "requiredEnvVars": [
    { "name": "CRON_SECRET", "required": true }
  ],
  "cookieCategories": [],
  "puckBlocks": [],
  "teardown": ["stk_import_log", "stk_import_job", "stk_settings"],
  "cronJobs": [
    { "path": "/api/m/stock-import-for-shop/cron/import", "schedule": "5 * * * *" }
  ]
}
